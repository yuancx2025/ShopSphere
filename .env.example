# Stripe test keys — get these from Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=

# Presentment currency (ISO 4217). Fulfillment refuses to mark an order paid if Stripe
# reports settlement in a different currency.
STRIPE_CURRENCY=usd

# Frontend origin Stripe redirects back to after payment
# Vite local: 5173    Docker frontend: 3000
BASE_URL=http://localhost:5173/

# Local Compose Postgres (docker compose up). For Neon cloud, use the pooled
# hostname (-pooler) for SPRING_DATASOURCE_URL and the direct hostname for Flyway.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ecommerce_v2
SPRING_DATASOURCE_USERNAME=ecommerce
SPRING_DATASOURCE_PASSWORD=ecommerce
SPRING_FLYWAY_URL=jdbc:postgresql://localhost:5432/ecommerce_v2
SPRING_FLYWAY_USER=ecommerce
SPRING_FLYWAY_PASSWORD=ecommerce

JWT_SECRET=ShopSphereDevSecretKeyMustBeAtLeast256BitsLongForHS256!!
